# Environment Configuration for AWX Netbox Frontend

# Node.js Configuration
NODE_ENV=development
PORT=3000

# Netbox Configuration
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=your_netbox_api_token_here

# AWX Configuration
AWX_URL=https://awx.example.com
AWX_USERNAME=admin
AWX_PASSWORD=your_awx_password_here
AWX_JOB_TEMPLATE_ID=1
AWX_ROLLBACK_TEMPLATE_ID=2
AWX_INVENTORY_ID=1

# Application Configuration
LOG_LEVEL=info
SESSION_SECRET=your_session_secret_here

# Security Configuration (for production)
# HTTPS_KEY=/path/to/ssl/key.pem
# HTTPS_CERT=/path/to/ssl/cert.pem

# Database Configuration (if using persistent storage)
# DATABASE_URL=postgresql://user:password@host:port/database