<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h2 class="card-title mb-0">
                    <i class="fas fa-tasks me-2"></i>
                    {{title}}
                </h2>
                <p class="card-text mb-0">Monitor AWX job status and manage configurations</p>
            </div>
            <div class="card-body">
                {{#if tasks.length}}
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="card bg-primary text-white">
                                    <div class="card-body text-center">
                                        <i class="fas fa-clock fa-2x mb-2"></i>
                                        <h4 id="pendingCount">{{countByStatus tasks 'pending'}}</h4>
                                        <small>Pending</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-warning text-dark">
                                    <div class="card-body text-center">
                                        <i class="fas fa-spinner fa-2x mb-2"></i>
                                        <h4 id="runningCount">{{countByStatus tasks 'running'}}</h4>
                                        <small>Running</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-success text-white">
                                    <div class="card-body text-center">
                                        <i class="fas fa-check fa-2x mb-2"></i>
                                        <h4 id="successCount">{{countByStatus tasks 'successful'}}</h4>
                                        <small>Successful</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-danger text-white">
                                    <div class="card-body text-center">
                                        <i class="fas fa-times fa-2x mb-2"></i>
                                        <h4 id="failedCount">{{countByStatus tasks 'failed'}}</h4>
                                        <small>Failed</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Job ID</th>
                                <th>Type</th>
                                <th>Target</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each tasks}}
                            <tr>
                                <td>
                                    <a href="/status/{{job_id}}" class="text-decoration-none">
                                        <strong>{{job_id}}</strong>
                                    </a>
                                    {{#if mock}}
                                    <span class="badge bg-secondary ms-1">DEMO</span>
                                    {{/if}}
                                </td>
                                <td>
                                    {{#if type}}
                                        {{#eq type 'rollback'}}
                                        <span class="badge bg-warning">
                                            <i class="fas fa-undo me-1"></i>Rollback
                                        </span>
                                        {{else}}
                                        <span class="badge bg-primary">
                                            <i class="fas fa-cog me-1"></i>{{type}}
                                        </span>
                                        {{/eq}}
                                    {{else}}
                                    <span class="badge bg-primary">
                                        <i class="fas fa-cog me-1"></i>Config
                                    </span>
                                    {{/if}}
                                </td>
                                <td>
                                    <div>
                                        <strong>{{data.hostname}}</strong>
                                        {{#if data.switch}}
                                        <br><small class="text-muted">{{data.switch}} - VLAN {{data.vlan}}</small>
                                        {{/if}}
                                    </div>
                                </td>
                                <td>
                                    <span class="badge status-badge status-{{status}}">
                                        {{#eq status 'pending'}}
                                        <i class="fas fa-clock me-1"></i>
                                        {{/eq}}
                                        {{#eq status 'running'}}
                                        <i class="fas fa-spinner fa-spin me-1"></i>
                                        {{/eq}}
                                        {{#eq status 'successful'}}
                                        <i class="fas fa-check me-1"></i>
                                        {{/eq}}
                                        {{#eq status 'failed'}}
                                        <i class="fas fa-times me-1"></i>
                                        {{/eq}}
                                        {{status}}
                                    </span>
                                </td>
                                <td>
                                    <small>{{formatDate created}}</small>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="/status/{{job_id}}" class="btn btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        {{#and (eq status 'successful') (not type)}}
                                        <button class="btn btn-outline-warning" onclick="rollbackJob('{{job_id}}')" title="Rollback">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                        {{/and}}
                                        {{#if url}}
                                        <a href="{{url}}" class="btn btn-outline-info" target="_blank" title="View in AWX">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                        {{/if}}
                                    </div>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                {{else}}
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No tasks found</h4>
                    <p class="text-muted">Start by creating a new configuration</p>
                    <a href="/form" class="btn btn-success">
                        <i class="fas fa-plus me-1"></i>
                        New Configuration
                    </a>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>

<script>
function rollbackJob(jobId) {
    if (!confirm(`Are you sure you want to rollback job ${jobId}? This will submit a new rollback job to AWX.`)) {
        return;
    }

    showLoading(true);

    fetch(`/rollback/${jobId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(result => {
        showLoading(false);
        
        if (result.success) {
            showAlert(`Rollback job submitted successfully! Job ID: ${result.rollback_job_id}`, 'success');
            setTimeout(() => {
                window.location.reload();
            }, 2000);
        } else {
            showAlert(`Rollback failed: ${result.error}`, 'danger');
        }
    })
    .catch(error => {
        showLoading(false);
        showAlert(`Rollback failed: ${error.message}`, 'danger');
    });
}

// Auto-refresh status every 30 seconds
setInterval(() => {
    window.location.reload();
}, 30000);
</script>