<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h2 class="card-title mb-0">
                    <i class="fas fa-home me-2"></i>
                    {{title}}
                </h2>
                <p class="card-text mb-0">{{description}}</p>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 border-success">
                            <div class="card-body text-center">
                                <i class="fas fa-edit fa-3x text-success mb-3"></i>
                                <h4 class="card-title">Configuration Form</h4>
                                <p class="card-text">Create new network configurations with Netbox integration</p>
                                <a href="/form" class="btn btn-success">
                                    <i class="fas fa-plus me-1"></i>
                                    New Configuration
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 border-info">
                            <div class="card-body text-center">
                                <i class="fas fa-tasks fa-3x text-info mb-3"></i>
                                <h4 class="card-title">Task Status</h4>
                                <p class="card-text">Monitor AWX job status and manage configurations</p>
                                <a href="/status" class="btn btn-info">
                                    <i class="fas fa-eye me-1"></i>
                                    View Status
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="card border-light">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Features
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <ul class="list-unstyled">
                                            <li class="mb-2">
                                                <i class="fas fa-check text-success me-2"></i>
                                                Netbox IPAM Integration
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-check text-success me-2"></i>
                                                AWX REST API Integration
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-check text-success me-2"></i>
                                                Switch Port Management
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <ul class="list-unstyled">
                                            <li class="mb-2">
                                                <i class="fas fa-check text-success me-2"></i>
                                                VLAN Configuration
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-check text-success me-2"></i>
                                                Real-time Status Monitoring
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-check text-success me-2"></i>
                                                Rollback Functionality
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-info">
                            <h5 class="alert-heading">
                                <i class="fas fa-lightbulb me-2"></i>
                                How it works
                            </h5>
                            <p class="mb-0">
                                This interface allows you to configure network switches by:
                                <strong>1)</strong> Checking available VLANs and switch ports from Netbox,
                                <strong>2)</strong> Submitting configuration jobs to Ansible AWX,
                                <strong>3)</strong> Monitoring job progress and status,
                                <strong>4)</strong> Rolling back configurations when needed.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>