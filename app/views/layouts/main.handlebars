<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - AWX Netbox Frontend</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .navbar-brand {
            font-weight: bold;
        }
        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border: 1px solid rgba(0, 0, 0, 0.125);
        }
        .status-badge {
            font-size: 0.875rem;
            padding: 0.375rem 0.75rem;
        }
        .status-pending { background-color: #ffc107; }
        .status-running { background-color: #0d6efd; }
        .status-successful { background-color: #198754; }
        .status-failed { background-color: #dc3545; }
        .status-canceled { background-color: #6c757d; }
        .footer {
            margin-top: 3rem;
            padding: 2rem 0;
            background-color: #f8f9fa;
            border-top: 1px solid #dee2e6;
        }
        .loading-spinner {
            display: none;
        }
        .form-floating label {
            color: #6c757d;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-network-wired me-2"></i>
                AWX Netbox Frontend
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="fas fa-home me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/form">
                            <i class="fas fa-edit me-1"></i>Configuration Form
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/status">
                            <i class="fas fa-tasks me-1"></i>Task Status
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/health">
                            <i class="fas fa-heartbeat me-1"></i>Health
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        {{{body}}}
    </main>

    <footer class="footer mt-auto">
        <div class="container text-center">
            <div class="row">
                <div class="col-md-12">
                    <p class="text-muted mb-0">
                        <i class="fas fa-cogs me-1"></i>
                        AWX Netbox Frontend - Network Automation Interface
                    </p>
                    <small class="text-muted">
                        Powered by Ansible AWX and Netbox IPAM
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global functions for status updates and form handling
        function showLoading(show = true) {
            const spinners = document.querySelectorAll('.loading-spinner');
            spinners.forEach(spinner => {
                spinner.style.display = show ? 'inline-block' : 'none';
            });
        }

        function showAlert(message, type = 'info') {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            const container = document.querySelector('main.container');
            container.insertBefore(alertDiv, container.firstChild);
            
            // Auto-dismiss after 5 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 5000);
        }

        function updateStatus(jobId) {
            fetch(`/status/${jobId}`)
                .then(response => response.text())
                .then(html => {
                    // Update the status section if it exists
                    const statusContainer = document.getElementById('status-container');
                    if (statusContainer) {
                        statusContainer.innerHTML = html;
                    }
                })
                .catch(error => {
                    console.error('Error updating status:', error);
                });
        }

        // Auto-refresh status pages every 30 seconds
        if (window.location.pathname.startsWith('/status')) {
            setInterval(() => {
                const jobId = window.location.pathname.split('/').pop();
                if (jobId && jobId !== 'status') {
                    updateStatus(jobId);
                }
            }, 30000);
        }
    </script>
</body>
</html>